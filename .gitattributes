# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.swift text eol=lf
*.sh text eol=lf

# Generated files should always use LF
Examples/Demo/WebClient/src/generated/** text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary


# Re-evaluation records in format 3.0 (binary log, #245)
*.reeval.sstr binary

# The plan status index: every plan PR adds a row, so two branches touching it conflict on
# adjacent lines. The union driver keeps both sides' lines in a local `git merge` (how main is
# brought into a branch here); it doesn't change GitHub's own mergeability check. A row one side
# changed comes out twice: scripts/check-plan-index.sh fails on that, in pre-push and in the
# Plan index workflow, which runs on a push or pull request to main or exp/** that changes the
# index, the check or the workflow, index-only changes included.
Notes/plans/README.md merge=union
