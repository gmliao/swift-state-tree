{
  "name": "visibility-test-smoke",
  "serverUrl": "ws://localhost:8080/game/visibility-test",
  "landType": "visibility-test",
  "syncIntervalMs": 50,
  "actions": [
    {
      "name": "SetMotionAction",
      "weight": 1,
      "payloadTemplate": {
        "enabled": true
      }
    }
  ],
  "events": [
    {
      "name": "MoveViewer",
      "ratePerSecond": 2,
      "payloadGenerator": "moveViewer"
    }
  ],
  "phases": {
    "preflight": {
      "durationSeconds": 3,
      "rooms": 1,
      "playersPerRoom": 4,
      "actionsPerSecond": 1,
      "verify": true,
      "thresholds": {
        "errorRate": 0.001,
        "disconnectRate": 0.001,
        "rttP95": 100,
        "rttP99": 250,
        "updateP95": 70,
        "updateP99": 250
      }
    },
    "steady": {
      "durationSeconds": 5,
      "rooms": 1,
      "playersPerRoom": 4,
      "actionsPerSecond": 1,
      "verify": false,
      "thresholds": {
        "errorRate": 0.001,
        "disconnectRate": 0.001,
        "rttP95": 100,
        "rttP99": 250,
        "updateP95": 70,
        "updateP99": 250
      }
    },
    "postflight": {
      "durationSeconds": 3,
      "rooms": 1,
      "playersPerRoom": 4,
      "actionsPerSecond": 1,
      "verify": true,
      "thresholds": {
        "errorRate": 0.001,
        "disconnectRate": 0.001,
        "rttP95": 100,
        "rttP99": 250,
        "updateP95": 70,
        "updateP99": 250
      }
    }
  }
}
