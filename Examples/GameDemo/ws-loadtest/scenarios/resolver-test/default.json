{
  "name": "resolver-test-default",
  "serverUrl": "ws://localhost:8080/game/resolver-test",
  "landType": "resolver-test",
  "syncIntervalMs": 50,
  "actions": [
    {
      "name": "CallServiceAction",
      "weight": 1,
      "payloadTemplate": {
        "tag": "load",
        "delayMs": -1,
        "deadlineMs": -1,
        "outcome": "rate"
      }
    }
  ],
  "phases": {
    "preflight": {
      "durationSeconds": 10,
      "rooms": 20,
      "playersPerRoom": 4,
      "actionsPerSecond": 2,
      "verify": true,
      "thresholds": {
        "errorRate": 0.001,
        "disconnectRate": 0.001,
        "rttP95": 400,
        "rttP99": 600,
        "updateP95": 70,
        "updateP99": 250
      }
    },
    "steady": {
      "durationSeconds": 60,
      "rooms": 200,
      "playersPerRoom": 4,
      "actionsPerSecond": 2,
      "verify": false,
      "thresholds": {
        "errorRate": 0.001,
        "disconnectRate": 0.001,
        "rttP95": 400,
        "rttP99": 600,
        "updateP95": 70,
        "updateP99": 250
      }
    },
    "postflight": {
      "durationSeconds": 10,
      "rooms": 20,
      "playersPerRoom": 4,
      "actionsPerSecond": 2,
      "verify": true,
      "thresholds": {
        "errorRate": 0.001,
        "disconnectRate": 0.001,
        "rttP95": 400,
        "rttP99": 600,
        "updateP95": 70,
        "updateP99": 250
      }
    }
  }
}
