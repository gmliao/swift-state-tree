# Multi-stage Dockerfile for DemoServer
# Stage 1: Build - compiles the Swift binary
# Stage 2: Run - the toolchain's runtime-only slim image (no compiler)

# -----------------------------------------------------------------------------
# Stage 1: Build Image
# -----------------------------------------------------------------------------
FROM swift:6.4.3-noble@sha256:4ed5e0210b244aab174450e0b79014c17db60c63c6daf0709347fe50c767293a AS builder

WORKDIR /workspace

# Copy full repo (Examples/Demo depends on root SwiftStateTree via path: "../..")
COPY . .

# Build release binary (resolution happens automatically)
RUN swift build -c release --package-path Examples/Demo --product DemoServer

# -----------------------------------------------------------------------------
# Stage 2: Run Image (swift:<pin>-noble-slim: Ubuntu 24.04 with the Swift runtime libraries and
# the packages Foundation needs, libcurl4, libxml2 and tzdata, from the same toolchain as the
# builder; #848). Its tag must match the build image's version and distro, and its digest is its
# own (scripts/check-ci-image-pin.sh checks both).
# -----------------------------------------------------------------------------
FROM swift:6.4.3-noble-slim@sha256:2bae57bd68ac95daa2d4aa2c7c590d4cf366c6007b4e5bc355e6cbe4dad16dcb AS runtime

# Create non-root user for k8s security context
RUN useradd -r -s /bin/false appuser

WORKDIR /app

# Copy only the compiled binary from builder
COPY --from=builder /workspace/Examples/Demo/.build/release/DemoServer /app/DemoServer

RUN chmod +x /app/DemoServer

USER appuser

ENV HOST=0.0.0.0
ENV PORT=8080

EXPOSE 8080

CMD ["./DemoServer"]
